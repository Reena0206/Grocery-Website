# Copy this file to ".env" for local overrides, or set these as environment
# variables on your hosting provider. Never commit your real .env file.

# --- Required in production ---
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# PostgreSQL connection (leave unset to use SQLite)
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# --- Optional ---
# TIME_ZONE=Asia/Kolkata
# MEDIA_ROOT=/var/data/media      # put uploads on a persistent disk
# SERVE_MEDIA=True                 # let Django serve uploaded images
# SECURE_SSL_REDIRECT=True
